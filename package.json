{
  "name": "pare-brise",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Pare-Brise : la salle de code virtuelle en 3D, pilotée par le contenu (iOS Capacitor)",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "ios": "npm run build && cap sync ios && cap open ios",
    "sync": "cap sync",
    "serve": "npx --yes serve docs -l 5173"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "esbuild": "^0.25.10",
    "three": "0.186.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elisabhty/pare-brise.git"
  },
  "homepage": "https://elisabhty.github.io/pare-brise/"
}
